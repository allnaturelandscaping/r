# ─── Base de datos MySQL ──────────────────────────────────────────────────────
# Formato: mysql://usuario:contraseña@host:puerto/nombre_db
DATABASE_URL=mysql://root:password@localhost:3306/lawnpro

# ─── Seguridad JWT ────────────────────────────────────────────────────────────
# Cadena aleatoria larga y secreta para firmar los tokens de sesión
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_cadena_secreta_muy_larga

# ─── Google OAuth2 ────────────────────────────────────────────────────────────
# Obtén estas credenciales en: https://console.cloud.google.com/
# 1. Crea un proyecto → APIs y servicios → Credenciales → Crear credencial → ID de cliente OAuth
# 2. Tipo: Aplicación web
# 3. URI de redireccionamiento autorizado: http://localhost:3000/api/auth/google/callback
#    (o tu dominio en producción: https://tudominio.com/api/auth/google/callback)
GOOGLE_CLIENT_ID=tu_client_id_de_google.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret_de_google

# ─── Configuración de la app ──────────────────────────────────────────────────
# URL base donde corre la app (sin barra final)
# En desarrollo: http://localhost:3000
# En producción: https://tudominio.com
APP_URL=http://localhost:3000

# ─── Admin (dueño de la app) ──────────────────────────────────────────────────
# El correo de Google que tendrá acceso de administrador automáticamente
OWNER_EMAIL=josuec20100@gmail.com

# ─── Puerto del servidor ──────────────────────────────────────────────────────
PORT=3000
